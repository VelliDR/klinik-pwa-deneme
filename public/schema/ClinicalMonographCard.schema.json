{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinicalMonographCard",
  "description": "Pediatrik Dozlama ve Klinik Karar Destek Sistemleri İçin Yapılandırılmış Çevrimdışı İlaç Monograf Şeması",
  "type": "object",
  "required": [
    "drug_id",
    "generic_name",
    "atc_code",
    "formulations",
    "dosing",
    "organ_impairment",
    "reproductive_safety",
    "safety_warnings",
    "metadata"
  ],
  "properties": {
    "drug_id": {
      "type": "string",
      "description": "Benzersiz ilaç kimliği (örn. amoxicillin_clavulanate_es, epinephrine)"
    },
    "generic_name": {
      "type": "string",
      "description": "Resmi Türkçe ve uluslararası jenerik etken madde adı"
    },
    "atc_code": {
      "type": "string",
      "description": "DSÖ Anatomik Terapötik Kimyasal (ATC) sınıflandırma kodu"
    },
    "formulations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "form_name",
          "concentration_mg_per_ml",
          "measuring_device"
        ],
        "properties": {
          "form_name": { "type": "string" },
          "concentration_mg_per_ml": { "type": "number" },
          "concentration_display": { "type": "string" },
          "measuring_device": {
            "type": "string",
            "enum": ["oral_syringe", "calibrated_cup", "dropper", "none"]
          },
          "reconstitution_stability_days": { "type": "integer" },
          "storage_condition": { "type": "string" }
        }
      }
    },
    "dosing": {
      "type": "object",
      "required": ["adult_dosing", "pediatric_dosing"],
      "properties": {
        "adult_dosing": {
          "type": "object",
          "properties": {
            "standard_single_dose_mg": { "type": "number" },
            "standard_interval_hours": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "max_daily_dose_mg": { "type": "number" }
          }
        },
        "pediatric_dosing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "indication",
              "min_age_months",
              "min_weight_kg",
              "dose_per_kg_single",
              "interval_hours",
              "max_daily_dose_mg_per_kg",
              "absolute_max_single_dose_mg",
              "absolute_max_daily_dose_mg"
            ],
            "properties": {
              "indication": { "type": "string" },
              "min_age_months": { "type": "number" },
              "min_weight_kg": { "type": "number" },
              "dose_per_kg_single": { "type": "number" },
              "interval_hours": { "type": "integer" },
              "max_daily_dose_mg_per_kg": { "type": "number" },
              "absolute_max_single_dose_mg": { "type": "number" },
              "absolute_max_daily_dose_mg": { "type": "number" },
              "weight_metric_in_obesity": {
                "type": "string",
                "enum": ["TBW", "IBW", "AdjBW"]
              }
            }
          }
        }
      }
    },
    "organ_impairment": {
      "type": "object",
      "properties": {
        "renal_adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "egfr_min": { "type": "number" },
              "egfr_max": { "type": "number" },
              "action_type": {
                "type": "string",
                "enum": ["DOSE_REDUCTION", "INTERVAL_EXTENSION", "CONTRAINDICATED"]
              },
              "adjustment_instruction": { "type": "string" }
            }
          }
        },
        "hepatic_adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "child_pugh_class": {
                "type": "string",
                "enum": ["Class_A", "Class_B", "Class_C"]
              },
              "action_instruction": { "type": "string" }
            }
          }
        }
      }
    },
    "reproductive_safety": {
      "type": "object",
      "properties": {
        "titck_legacy_category": { "type": "string" },
        "pregnancy_trimester_risk": {
          "type": "object",
          "properties": {
            "first_trimester": { "type": "string" },
            "second_trimester": { "type": "string" },
            "third_trimester": { "type": "string" }
          }
        },
        "lactation": {
          "type": "object",
          "properties": {
            "lactmed_record_summary": { "type": "string" },
            "relative_infant_dose_percent": { "type": "number" },
            "safety_verdict": {
              "type": "string",
              "enum": ["COMPATIBLE", "USE_WITH_CAUTION", "CONTRAINDICATED"]
            }
          }
        }
      }
    },
    "safety_warnings": {
      "type": "object",
      "properties": {
        "black_box_warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "absolute_contraindications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "neonatal_specific_notes": { "type": "string" },
        "critical_drug_interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "interacting_drug": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["MAJOR", "MODERATE"]
              },
              "clinical_management": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["source_documents", "version_date", "last_reviewed_iso"],
      "properties": {
        "source_documents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version_date": { "type": "string" },
        "last_reviewed_iso": { "type": "string" }
      }
    }
  }
}
